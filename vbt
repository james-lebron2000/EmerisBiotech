#!/bin/sh
set -eu
VBT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
VBT_RUNTIME=${VBT_PYTHON:-"$HOME/Library/Application Support/VirtualBiotech/venv/bin/python"}
if [ ! -x "$VBT_RUNTIME" ]; then
    echo "Runtime missing. Run ./setup.sh or set VBT_PYTHON." >&2
    exit 2
fi
PYTHONPATH="$VBT_ROOT/src" exec "$VBT_RUNTIME" -m vbt.cli --workspace "$VBT_ROOT" "$@"
